# =============================================================
#  LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
#  ⚠️  NEVER commit this file to git — it contains secrets!
#  Copy this file to .env and fill in your local values.
# =============================================================

# --- Database ---
SERVER_PORT=5001
DB_URL=jdbc:mysql://localhost:3306/gym?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
DB_DDL_AUTO=validate

# --- JWT ---
# Generate a new key: openssl rand -base64 32
JWT_SECRET_KEY=

# --- Admin Account (seeded on first run) ---
ADMIN_SEED_ENABLED=false
ADMIN_USERNAME=gymtl_admin_2025
ADMIN_PASSWORD=
ADMIN_EMAIL=gymtelligent.admin@gmail.com

# --- CORS (comma-separated list of allowed origins) ---
BASE_URL=https://gymtelligent.io.vn
CORS_ALLOWED_ORIGINS=https://gymtelligent.io.vn

# --- Logging ---
LOG_LEVEL_ROOT=warn
LOG_LEVEL_APP=info

# --- SQL Logging (set to true only when debugging queries locally) ---
JPA_SHOW_SQL=false
